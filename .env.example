# Copy to .env.local (gitignored). Tests and the build run without real values.

# Browser: Supabase URL + publishable key (read-only under RLS). Used for the
# stats proxy edge function and the Results tab.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Nightly scripts (daily-predict, backup).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
